@page
@model BeatAlert.Presentation.Pages.HomeModel
@{
    ViewData["Title"] = "Home";
}

<header class="topbar">
  
  <form method="get" action="/Search" class="search">
    <input name="q" placeholder="Search" aria-label="Search" />
  </form>

  <div class="icons">
    <a href="/Notifications" aria-label="Notifications" title="Notifications">🔔</a>
    <a href="/Profile" aria-label="Profile" title="Profile">👤</a>
  </div>
</header>

<main class="container">
  <div class="welcome">
    <h2>Welcome back!</h2>
  </div>

  @* New Releases *@
  
  <section class="section">
    <h3>New Album Releases</h3>
    <div class="grid">
      @if (Model.Albums?.Any() == true)
      {
        foreach (var r in Model.Albums)
        {
          <partial name="_ReleaseCard" model="@r" />
        }
      }
      else
      {
        <p>No albums found.</p>
      }
    </div>
  </section>
</main>
