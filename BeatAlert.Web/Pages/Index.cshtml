@page
@model BeatAlert.Web.Pages.Index
@{
    ViewData["Title"] = "Start Up";
}

@{
    Layout = "_Layout";
}

<header>
    <div>
        <h2>BeatAlert</h2>
    </div>
    <nav>
        <button type="button" class="btn btn-cta"><a asp-page="/Login"> Log In</a></button>
        <button type="button" class="btn btn-cta"><a asp-page="/Register">Sign Up</a></button>
    </nav>
</header>

<section class="mt-5">
    <div>
        <h1>Never Miss a New Release Again</h1>
        <p>BeatAlert keeps you updated on your favorite artists — new songs, albums, and upcoming concerts.  
            All in one place, right when it happens.</p>
        <button type="button" class="btn btn-cta"><a asp-page="/Register">Start Now</a></button>
    </div>
    
</section>

<section class="mt-5">
    <h3>Features section</h3>
    <div class="col">
        <p>Track Your Favorite Artists</p>
    </div>
    <div class="col">
        <p>Real-Time Release Alerts</p>
    </div>
    <div class="col">
        <p>Concert & Tour Notifications</p>
    </div>

</section>

<footer class="text-center mt-5">
    <h3>BeatAlert</h3>
    <p>
        <a href="#">About</a> |
        <a href="#">Contact</a>
    </p>
    <small>© 2025 BeatAlert</small>
</footer>