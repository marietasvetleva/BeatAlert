@page
@model BeatAlert.Web.Pages.Index

@{
    ViewData["Title"] = "Start Up";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
</head>
<body>

<!-- Header -->
<header>
    <div>
        <h2>BeatAlert</h2>
    </div>
    <nav>
        <a href="#">Navigation Link 1</a>
        <a href="#">Navigation Link 2</a>
        <input type="search" placeholder="Search" />
        <button>Log In</button>
        <button>Sign Up</button>
    </nav>
</header>

<!-- Hero Section -->
<section>
    <div>
        <h1>Headline</h1>
        <p>Subtext</p>
        <button>Start Now</button>
    </div>
    <div>
        <img src="#" alt="Placeholder image" width="400" height="250" />
    </div>
</section>

<!-- Features Section -->
<section>
    <h3>Features section</h3>
    <div>
        <img src="#" alt="Feature 1 icon" width="60" height="60" />
        <p>Feature 1</p>
    </div>
    <div>
        <img src="#" alt="Feature 2 icon" width="60" height="60" />
        <p>Feature 2</p>
    </div>
    <div>
        <img src="#" alt="Feature 3 icon" width="60" height="60" />
        <p>Feature 3</p>
    </div>
</section>

<!-- Footer -->
<footer>
    <div>
        <h3>BeatAlert</h3>
    </div>
    <div>
        <a href="#">About</a> |
        <a href="#">Contact</a>
    </div>
    <small>Copyright © 2025 Company name</small>
</footer>

</body>
</html>
