<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeatAlert</title>

    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app">
    <!-- Global header -->
    <header class="app-header">
        <div class="app-header__left">
            <a class="logo" asp-area="" asp-page="/Home">BeatAlert</a>
        </div>
        
        <div class="app-header__right">
            <form asp-page="/Search" method="get" class="search">
                <input type="text" name="Query" class="search__input" placeholder="Search artists..." />
            </form>

            @if (User.Identity.IsAuthenticated)
            {
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="btn btn--ghost">Logout</button>
                </form>
            }
            else
            {
                <a class="btn btn--ghost" asp-area="" asp-page="/Login">Login</a>
                <a class="btn btn--primary" asp-area="" asp-page="/Home">Register</a>
            }
        </div>
    </header>

    
    <main class="app-main" role="main">
        @RenderBody()
    </main>

    
    <footer class="app-footer">
        <span>© @DateTime.Now.Year BeatAlert</span>
        <span> · </span>
        <a asp-area="" asp-page="/Privacy">Privacy</a>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
