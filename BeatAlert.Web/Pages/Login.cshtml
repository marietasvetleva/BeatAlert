@page
@model BeatAlert.Web.Pages.Login

@{
    Layout = "_Layout";
}

<section class="page-section" style="max-width: 480px; margin: 0 auto;">
    <h1 class="page-title">Login</h1>

    
    @if (!ViewData.ModelState.IsValid)
    {
        <div style="color: #f87171; margin-bottom: 12px;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }


    <form method="post" class="auth-form">

        <div class="form-group">
            <label for="identifier">Email or Username</label>
            <input id="identifier"
                   name="Input.Identifier"
                   class="form-control auth-input"
                   type="text"
                   value="@Model.Input.Identifier" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input id="password"
                   name="Input.Password"
                   class="form-control auth-input"
                   type="password" />
        </div>

        <div class="form-check" style="margin-top: 6px;">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Stay logged in</label>
        </div>

        <button type="submit" class="btn btn--primary" style="margin-top: 14px;">
            Login
        </button>

    </form>
</section>